  Widget _factionButton(String text, bool light) => Container(
    width: 255,
    height: 52,
    alignment: Alignment.center,
    decoration: BoxDecoration(
      gradient: LinearGradient(
        colors: light
            ? const [Color(0xff245488), Color(0xff0f263e)]
