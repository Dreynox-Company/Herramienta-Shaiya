
    padding: const EdgeInsets.fromLTRB(19, 14, 16, 12),
    decoration: BoxDecoration(
      gradient: const LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: [Color(0xee6c1720), Color(0xee160909)],
      ),
      border: Border.all(color: const Color(0xffa66f57)),
      borderRadius: BorderRadius.circular(5),
    ),
    child: Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Row(
          children: [
            Text('Nv. ${character.level}', style: const TextStyle(fontSize: 11)),
            const SizedBox(width: 28),
            Expanded(
              child: Text(character.name, style: const TextStyle(fontSize: 11), overflow: TextOverflow.ellipsis),
            ),
            Text(lightFaction ? 'Luchador' : 'Guerrero', style: const TextStyle(fontSize: 11)),
          ],
        ),
        const SizedBox(height: 12),
        Container(height: 1, color: const Color(0xff6a4c42)),
        const SizedBox(height: 10),
        const Text('Última ubicación: Erina', style: TextStyle(fontSize: 10)),
        const SizedBox(height: 9),
        Text('Modo: ${character.mode == 2 ? 'BÁSICO' : character.mode}', style: const TextStyle(fontSize: 10)),
      ],
    ),
  );

  Widget _emptyCharacterSlot() => Container(
    alignment: Alignment.center,
    decoration: BoxDecoration(
      color: const Color(0xe50b0707),
      border: Border.all(color: const Color(0xff51433e)),
      borderRadius: BorderRadius.circular(5),
    ),
    child: const Text('Crea un personaje.', style: TextStyle(color: Color(0xffc9c2c2), fontSize: 15)),
  );

  Widget _nativeButton(String label, VoidCallback action, {double width = 120}) => SizedBox(
    width: width,
    height: 37,
    child: OutlinedButton(
      onPressed: action,
      style: OutlinedButton.styleFrom(
        foregroundColor: Colors.white,
        backgroundColor: const Color(0xdd481216),
        side: const BorderSide(color: Color(0xffa46c54)),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(4)),
        padding: EdgeInsets.zero,
      ),
      child: Text(label, style: const TextStyle(fontSize: 11)),
    ),
  );

  Widget _worldScreen() => Stack(
    fit: StackFit.expand,
    children: [
      Positioned.fill(child: renderer.build()),
      Positioned.fill(
        child: ViewportMovementInput(
          focusNode: focus,
          onChanged: (x, z, run) => scene.setMovement(x, z, run: run),
          onAction: (key) {
            if (key == LogicalKeyboardKey.space) unawaited(scene.jump());
            if (key == LogicalKeyboardKey.tab) scene.cycleOpponent();
            if (key == LogicalKeyboardKey.escape) {
              scene.clearMovement();
              if (activeQuest != null) {
                setState(() {
                  activeQuest = null;
                  activeQuestNpc = null;
                });
              }
            }
          },
          child: Listener(
            onPointerSignal: (event) {
              if (event is PointerScrollEvent) {
                scene.zoom(event.scrollDelta.dy > 0 ? 1.08 : 1 / 1.08);
              }
            },
            child: GestureDetector(
              behavior: HitTestBehavior.opaque,
              onTap: () => focus.requestFocus(),
              onScaleStart: (_) {
                gestureScale = 1;
                focus.requestFocus();
              },
              onScaleUpdate: (d) {
                if (d.pointerCount == 1) {
                  scene.orbit(d.focalPointDelta.dx, d.focalPointDelta.dy);
                } else {
                  scene.zoom(gestureScale / d.scale);
                  gestureScale = d.scale;
                }
              },
              child: const SizedBox.expand(),
            ),
          ),
        ),
      ),
      _referenceCanvas(
        Stack(
          children: [
            _hudStats(),
            _hudHotbar(),
            _hudMinimap(),
            _hudChat(),
            _hudBottom(),
            if (activeQuest != null) _questWindow(activeQuest!),
            ..._npcLabels(),
          ],
        ),
      ),
    ],
  );

