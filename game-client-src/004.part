  Widget _statBar(double left, double top, int value, int max, Color color) => Positioned(
    left: left,
    top: top,
    width: 155,
    height: 12,
    child: Stack(
      fit: StackFit.expand,
      children: [
        Container(color: const Color(0xaa080808)),
        FractionallySizedBox(
          widthFactor: value / max,
          alignment: Alignment.centerLeft,
          child: Container(color: color),
        ),
        Center(child: Text('$value / $max', style: const TextStyle(fontSize: 9, color: Colors.white))),
      ],
    ),
  );

