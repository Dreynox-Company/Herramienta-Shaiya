+          ExportProgress(
+            'Verificado',
+            e.path,
+            i + 1,
+            list.length,
+            doneBytes,
+            totalBytes,
+          ),
+        );
+        await Future<void>.delayed(Duration.zero);
+      }
+      if (saf != null) {
+        await saf.flush();
+        await saf.close();
+        saf = null;
