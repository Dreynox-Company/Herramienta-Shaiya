+              .bind(dataFile.openRead(e.offset, e.offset + e.length))
+              .first;
+          if (saved.toString() != manifests[i]['sha256']) {
+            throw FormatException('SAF escrito incorrectamente: ${e.path}.');
+          }
+          notify(
+            ExportProgress(
+              'Verificando SAF',
+              e.path,
+              i + 1,
+              list.length,
+              i + 1,
+              list.length,
+            ),
+          );
+        }
+      }
+      control.check();
+      await File('${staging.path}/manifest-shaiya-$id.json')