+    final manifests = <Map<String, Object?>>[];
+    var offset = 0, doneBytes = 0;
+    final totalBytes = list.fold<int>(
+      0,
+      (n, e) => n + (replacements[e.path]?.length ?? e.length),
+    );
+    RandomAccessFile? saf;
+    try {
+      if (pack) {
