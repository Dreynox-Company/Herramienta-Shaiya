+    test('cabecera extendida válida', () {
+      final data = Uint8List.fromList([1, 2, 3]);
+      expect(
+        SeedData.decode(
+          SeedData.encode(data, extended: true),
+          verifyChecksum: true,
+        ),
+        data,
+      );
+    });
+    test('un campo editado se cifra y relee', () {
+      final raw = binaryTabl